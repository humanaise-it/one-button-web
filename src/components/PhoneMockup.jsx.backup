
import React, { useState, useRef, useEffect } from 'react';

const SAMPLE_LINES = [
  "Okay, let me walk you through the next steps.",
  "I think the main issue is the timeline alignment.",
  "Can we clarify the deliverables for tomorrow’s meeting?",
  "Yes, that works for me.",
  "Let’s quickly recap what we agreed on.",
  "Good point — I'll adjust that.",
  "We should document this decision.",
  "Can you repeat that last part?",
  "Perfect, let's move forward.",
  "I'll follow up with an email summary."
];

function getRandomLine() {
  return SAMPLE_LINES[Math.floor(Math.random() * SAMPLE_LINES.length)];
}

const MAX_VISIBLE = 7; // max lines visible in viewport
const LINE_HEIGHT = 28; // px, for translateY math (mobile)

function PhoneMockup() {
  const [state, setState] = useState('idle');
  const [transcript, setTranscript] = useState([]); // {id, text, ts}
  const [showToast, setShowToast] = useState(false);
  const [animOffset, setAnimOffset] = useState(0); // for translateY
  const rippleRef = useRef(null);
  const intervalRef = useRef(null);
  const animTimeoutRef = useRef(null);
  const nextId = useRef(0);

  // Responsive helpers
  const isMobile = () => window.innerWidth < 768;
  const isSmallDesktop = () => window.innerWidth < 800;

  // Infinite transcription effect
  useEffect(() => {
    if (state === 'recording') {
      setTranscript([]);
      setAnimOffset(0);
      nextId.current = 0;
      let running = true;
      function addLine() {
        if (!running) return;
        setTranscript(prev => {
          const newLine = {
            id: nextId.current++,
            text: getRandomLine(),
            ts: Date.now()
          };
          // Remove old lines if > MAX_VISIBLE+2
          let arr = [...prev, newLine];
          if (arr.length > MAX_VISIBLE + 2) arr = arr.slice(arr.length - (MAX_VISIBLE + 2));
          return arr;
        });
        setAnimOffset(prev => prev + 1);
        // Next line in 1–2s
        intervalRef.current = setTimeout(addLine, 1000 + Math.random() * 1000);
      }
      addLine();
      return () => { running = false; clearTimeout(intervalRef.current); };
    } else {
      clearTimeout(intervalRef.current);
    }
    // Cleanup
    return () => clearTimeout(intervalRef.current);
  }, [state]);

  // Reset animOffset when transcript is cleared
  useEffect(() => {
    if (transcript.length === 0) setAnimOffset(0);
  }, [transcript]);

  // Handle press logic
  const handlePress = () => {
    if (state === 'idle') {
      setState('pressing');
      if (rippleRef.current) {
        rippleRef.current.classList.remove('active');
        void rippleRef.current.offsetWidth;
        rippleRef.current.classList.add('active');
      }
      setTimeout(() => {
        startRecording();
      }, 90);
    } else if (state === 'recording') {
      stopRecording();
    }
  };

  const startRecording = () => {
    setState('recording');
    setTranscript([]);
    setAnimOffset(0);
  };

  const stopRecording = () => {
    setState('ended');
    clearTimeout(intervalRef.current);
    // Show notification after a short delay
    setTimeout(() => {
      setShowToast(true);
      // Hide after 1.2s, then reset
      animTimeoutRef.current = setTimeout(() => {
        setShowToast(false);
        setTranscript([]);
        setAnimOffset(0);
        setState('idle');
      }, 1200);
    }, 400);
  };

  // Cleanup notification timer
  useEffect(() => {
    return () => clearTimeout(animTimeoutRef.current);
  }, []);

  // Compute transform for transcript viewport
  const getTranscriptTransform = () => {
    // Only scroll if more than MAX_VISIBLE lines
    const over = transcript.length - MAX_VISIBLE;
    if (over > 0) {
      return `translateY(-${over * LINE_HEIGHT}px)`;
    }
    return 'translateY(0)';
  };

  // Notification content
  const Notification = () => (
    <div className="visionos-toast">
      <div className="visionos-toast-content">
        <div className="visionos-toast-title">Meeting processed</div>
        <div className="visionos-toast-desc">Your summary will be delivered shortly.</div>
      </div>
    </div>
  );

  // Mic button classes
  const getMicButtonClass = () => {
    let base = 'mic-button';
    if (state === 'idle' || state === 'pressing') base += ' idle';
    if (state === 'recording') base += ' recording';
    if (state === 'ended') base += ' ended';
    if (isMobile() || (state === 'recording' && isSmallDesktop())) base += ' docked';
    return base;
  };

  // Equalizer classes
  const getEqClass = () => {
    let base = 'equalizer visible';
    if (isMobile() || (state === 'recording' && isSmallDesktop())) base += ' eq-docked';
    return base;
  };

  // Status text
  const getStatusText = () => {
    switch (state) {
      case 'recording':
        return 'Listening…';
      case 'ended':
        return 'Processing...';
      default:
        return 'Tap to record';
    }
  };



  return (
    <div className="phone-mockup">
      <div className="phone-frame">
        <div className="phone-notch"></div>
        <div className="phone-screen">
          <div className="mic-interface">
            <button
              className={getMicButtonClass()}
              onClick={handlePress}
              aria-label="Toggle recording"
            >
              <div className="ripple" ref={rippleRef}></div>
              <svg className="mic-icon" viewBox="0 0 24 24" fill="none">
                <path d="M12 7C10.9 7 10 7.9 10 9V13C10 14.1 10.9 15 12 15C13.1 15 14 14.1 14 13V9C14 7.9 13.1 7 12 7Z" fill="currentColor"/>
                <path d="M16 11C16 13.2091 14.2091 15 12 15C9.79086 15 8 13.2091 8 11H7C7 13.7614 9.23858 16 12 16C14.7614 16 17 13.7614 17 11H16Z" fill="currentColor"/>
                <rect x="11.5" y="16" width="1" height="2" fill="currentColor"/>
              </svg>
            </button>

            {state === 'idle' && (
              <div className="status-text idle">
                {getStatusText()}
              </div>
            )}

            {state === 'recording' && (
              <>
                <div className="transcript-panel">
                  <div className="mask-top"></div>
                  <div className="mask-bottom"></div>
                  <div
                    className="transcript-lines"
                    style={{
                      transform: getTranscriptTransform(),
                      transition: 'transform 0.5s cubic-bezier(.4,1.2,.4,1)',
                    }}
                  >
                    {transcript.map((line, idx) => (
                      <div
                        key={line.id}
                        className="transcript-line"
                        style={{
                          opacity: idx < transcript.length - MAX_VISIBLE ? 0 : 0.85,
                          transition: 'opacity 0.5s',
                        }}
                      >
                        <span className="transcript-text">{line.text}</span>
                      </div>
                    ))}
                  </div>
                </div>
                <div className={getEqClass()}>
                  <div className="bar bar-1"></div>
                  <div className="bar bar-2"></div>
                  <div className="bar bar-3"></div>
                </div>
              </>
            )}

            {showToast && <Notification />}
          </div>
        </div>
      </div>
    </div>
  );
}

export default PhoneMockup;
